# =======================================================
# FIRST BAPTIST CHURCH JOBELE - ENVIRONMENT CONFIGURATION
# =======================================================

# 1. AUTHENTICATION & SECURITY
# A strong random string for signing JWT tokens
JWT_SECRET=fbc-jobele-divine-power-secret-key-2026-unshakable

# Security Passcode required for Church Staff & Admin Self-Registration at /admin/register
# Share this only with appointed ministers, deacons, and media team workers.
CHURCH_STAFF_PASSCODE=FBC-JOBELE-COVENANT-2026

# 2. CLOUD MEDIA STORAGE (CLOUDINARY)
# When deploying to Vercel, sign up for a free Cloudinary account at https://cloudinary.com
# and copy these credentials from your Cloudinary Dashboard.
# All photos uploaded via the Admin CMS will automatically persist on Cloudinary's global CDN.
# (If omitted in local development, uploads are saved to /public/uploads/ automatically)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 3. DOMAIN & METADATA
NEXT_PUBLIC_SITE_URL=https://fbcjobele.org
